# https://supabase.com → Project Settings → API → Copy Project URL + anon key
# Формат: VITE_SUPABASE_URL=https://xxxxx.supabase.co
#         VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Если поля пусты — игра работает с локальными рекордами (без мировой таблицы).
#
# VITE_SCORE_SECRET — секрет для подписи очков (анти-накрутка).
# В продакшене желательно перенести на бэкенд (Supabase Edge Function).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SCORE_SECRET=

