# https://supabase.com → Project Settings → API → Copy Project URL + anon key
# Формат: VITE_SUPABASE_URL=https://xxxxx.supabase.co
#         VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Если поля пусты — игра работает с локальными рекордами (без мировой таблицы).
#
# Секрет подписи очков (SCORE_SECRET) в .env больше не нужен: он хранится
# в секретах Edge Function «scores» (см. docs/DEVELOPMENT.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

